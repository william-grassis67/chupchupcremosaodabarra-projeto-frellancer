# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Database (MySQL connection string used by Prisma)
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://delivery_user:DeliveryPass123!@localhost:3306/delivery_db"
# CORS
# Comma-separated list of allowed origins. Use * only in development.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://localhost:5501

# Delivery fee (used as fallback/default when calculating orders)

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin (reserved for future authentication - not used yet)
ADMIN_PASSWORD_HASH=
